{
  "name": "chimera",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Chimera — Self-Serve Deception Mesh (Zerops Challenge 2026)",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx infra/seed/seed.ts",
    "db:seed:demo": "tsx infra/seed/seed-demo.ts",
    "db:seed:intel": "tsx infra/seed/seed-threat-intel.ts"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.28.0",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.7",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}

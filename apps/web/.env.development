# Development-only frontend config (committed; contains no secrets).
# Vite loads this automatically for `vite dev`. Both the REST base and the
# WebSocket URL are derived from VITE_API_URL. For production, set VITE_API_URL
# at build time, e.g. VITE_API_URL=https://api.example.com pnpm --filter @chimera/web build
VITE_API_URL=http://localhost:3000

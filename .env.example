# Chimera — environment template (M0). Copy to .env for local dev.
# Real values live ONLY in your local .env (gitignored) and Zerops secret env vars.
# In production most of these are auto-injected by Zerops (e.g. ${db_connectionString}).

# --- Managed service connections (local dev points at docker-compose.dev.yml) ---
DATABASE_URL=postgres://chimera:chimera@localhost:5432/chimera
VALKEY_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=chimera
S3_ACCESS_KEY=chimera
S3_SECRET_KEY=chimera123

# --- App ---
NODE_ENV=development
JWT_SECRET=dev-only-change-me
PUBLIC_API_URL=http://localhost:3000

# --- Decoys ---
DECOY_SSH_PORT=2222
DECOY_HTTP_PORT=8080
